# ============================================================
# R2 — Ghost Protocol · .gitignore
# ============================================================

# --- Perfis de browser (Chromium / Playwright) ---
broker10_profile/
tiktok_profile/
*_profile/

# --- Cookies e credenciais ---
*.txt
!requirements.txt
!estrutura.txt
!atualizacao.txt
*.json
!config.json
!environment.yml
*_cookies*
*.env
.env*
!.env.example

# --- Modelos de IA (pesados demais) ---
models/
*.gguf
*.bin
*.pt
*.safetensors

# --- Áudio e vídeo gerados ---
*.mp3
*.mp4
*.wav
*.webm
static/media/
temp_files/
temp_video/

# --- Logs e debug ---
*.log
packets_debug.txt
static/logs/
logs/

# --- Cache Python ---
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# --- RAG / FAISS index (gerado em runtime) ---
static/docs/faiss_index.bin
static/docs/rag_data.json

# --- Uploads de usuário ---
uploads/

# --- Backups automáticos ---
backup/
backup_*/
*.bak

# --- Arquivos temporários e debug ---
*.tmp
*.temp
maior_area
alpha_debug.png
INI.png
radar_scan.png
fala_r2.mp3
teste_voz.mp3
tts_*.mp3

# --- VS Code / IDE ---
.vs/
.vscode/
*.suo
*.user

# --- Windows ---
Thumbs.db
Desktop.ini